# --- Database -------------------------------------------------------
# Local dev (docker-compose Postgres):
DATABASE_URL=postgres://wims:wims@localhost:55432/wims
# Tests run against a separate database on the same instance:
TEST_DATABASE_URL=postgres://wims:wims@localhost:55432/wims_test
# Production: paste the POOLED connection string from Neon
# DATABASE_URL=postgres://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/wims?sslmode=require

# --- Auth -----------------------------------------------------------
# Random 64+ char string. Generate with:
#   openssl rand -base64 64
JWT_SECRET=replace-me-with-a-long-random-string

# --- Google Places (Phase 4+) --------------------------------------
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# --- App ------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
